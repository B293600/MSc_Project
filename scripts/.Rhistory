other_proportion <- category_review %>%
group_by(source) %>%
summarise(
total = sum(n),
other = sum(n[category == "Other / unclassified"]),
pct_other = round(100 * other / total, 1),
.groups = "drop"
) %>%
arrange(desc(pct_other))
cat("\n% of terms falling into 'Other / unclassified' per plot",
"(high values = keyword list needs extending):\n")
print(other_proportion)
write_tsv(category_review, file.path(output_dir, "go_category_review_all_plots.txt"))
for (nm in names(all_go_plots)) {
ggsave(file.path(figures_dir, paste0(nm, "_categorised.png")),
plot = all_go_plots[[nm]], width = 11, height = 9, dpi = 300)
}
cat("Done -", length(all_go_plots), "categorised plots saved to figures/,",
"review table saved to output_tables/go_category_review_all_plots.txt\n")
